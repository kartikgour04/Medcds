# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/medcds

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Disease Prediction APIs
INFERMEDICA_APP_ID=your_infermedica_app_id
INFERMEDICA_APP_KEY=your_infermedica_app_key
INFERMEDICA_API_URL=https://api.infermedica.com/v3

ISABEL_API_KEY=your_isabel_api_key
ISABEL_API_URL=https://www.isabelhealthcare.com/api

# Drug APIs
OPENFDA_API_KEY=your_openfda_api_key
OPENFDA_API_URL=https://api.fda.gov
RXNORM_API_URL=https://rxnav.nlm.nih.gov/REST
DRUGBANK_API_KEY=your_drugbank_api_key
DRUGBANK_API_URL=https://api.drugbankplus.com/v1
DAILYMED_API_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2

# AI/NLP
OPENAI_API_KEY=your_openai_api_key
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-credentials.json

# Human API
HUMAN_API_CLIENT_ID=your_human_api_client_id
HUMAN_API_CLIENT_SECRET=your_human_api_client_secret

# Redis Cache
REDIS_URL=redis://redis:6379

# FHIR
FHIR_SERVER_URL=https://hapi.fhir.org/baseR4

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# PDF
PDF_OUTPUT_DIR=/app/reports
